.ph .lead{margin-top:26px}
.bento{display:grid; grid-template-columns:repeat(6,1fr); gap:14px}
.bento > *{background:var(--bg-2); border:1px solid var(--line); border-radius:22px; padding:clamp(22px,3vw,34px); display:grid; gap:12px; align-content:start}
.b-3{grid-column:span 3} .b-2{grid-column:span 2} .b-4{grid-column:span 4} .b-6{grid-column:span 6}
@media (max-width:880px){ .bento > *{grid-column:span 6} }
.bento h3{font-size:24px; letter-spacing:-.03em}
.bento p{color:var(--ink-2)}
.bento .k{font:500 12px/1 var(--mono); color:var(--ink-3)}
.bento .dark{background:var(--inv-bg); color:var(--inv-ink); border-color:var(--inv-bg)}
.bento .dark p{color:var(--inv-2)}
.bento .dark .k{color:var(--inv-2)}
.mini-chart{display:flex; align-items:end; gap:5px; height:92px; margin-top:8px}
.mini-chart i{flex:1; border-radius:4px 4px 2px 2px; background:var(--line-2)}
.mini-chart i.h{background:var(--up)}
.split{display:grid; grid-template-columns:.9fr 1.1fr; gap:clamp(28px,5vw,80px); align-items:start}
@media (max-width:880px){ .split{grid-template-columns:1fr} }
.list{list-style:none; margin:0; padding:0; border-top:1px solid var(--line)}
.list li{display:grid; grid-template-columns:28px 1fr; gap:14px; padding:20px 0; border-bottom:1px solid var(--line)}
.list li svg{margin-top:3px}
.list b{display:block; font-size:18px; letter-spacing:-.02em; font-weight:600}
.list span{color:var(--ink-2); font-size:15px}
.price{border:1px solid var(--line); border-radius:24px; padding:clamp(24px,3.4vw,40px); box-shadow:var(--lift); display:grid; gap:22px; background:var(--bg)}
.price-row{display:grid; grid-template-columns:1fr auto 1fr; gap:14px; align-items:stretch}
.price-row .plus{align-self:center; font:400 28px/1 var(--mono); color:var(--ink-3)}
.pp{background:var(--bg-2); border-radius:16px; padding:20px; display:grid; gap:6px; align-content:start}
.pp .v{font:600 28px/1.1 var(--mono); letter-spacing:-.04em}
.pp .k{font-size:14px; color:var(--ink-2)}
@media (max-width:560px){ .price-row{grid-template-columns:1fr} .price-row .plus{text-align:center} }
.seg-tabs{display:grid; grid-template-columns:repeat(4,1fr); gap:4px; padding:4px; border-radius:14px; background:var(--bg-2)}
.seg-tabs button{appearance:none; border:0; background:transparent; font:500 14px/1 var(--sans, inherit); color:var(--ink-2); padding:11px 6px; border-radius:10px; cursor:pointer; transition:background .2s, color .2s, box-shadow .2s}
.seg-tabs button[aria-selected="true"]{background:var(--bg); color:var(--ink); box-shadow:0 1px 2px rgba(0,0,0,.08), 0 0 0 1px var(--line)}
.seg-tabs button:focus-visible{outline:2px solid var(--ink); outline-offset:2px}
.t-facts{display:grid; grid-template-columns:1fr 1fr 1.6fr; gap:0; margin:0; border-top:1px solid var(--line); border-bottom:1px solid var(--line)}
.t-facts > div{padding:14px 12px 14px 0}
.t-facts > div + div{padding-left:14px; border-left:1px solid var(--line)}
.t-facts dt{font:500 12px/1 var(--mono); color:var(--ink-3)}
.t-facts dd{margin:8px 0 0; font-size:15px; font-weight:600; letter-spacing:-.01em}
@media (max-width:560px){ .t-facts{grid-template-columns:1fr 1fr} .t-facts > div:last-child{grid-column:span 2; border-left:0; padding-left:0; border-top:1px solid var(--line)} }
.commit{display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:start; padding:18px; border-radius:16px; background:var(--up-soft)}
.commit b{font:600 34px/1 var(--mono); letter-spacing:-.05em; color:var(--up)}
.commit p{font-size:15px; color:var(--ink)}
.ph-hold{background:var(--bg-3); color:var(--ink-3); border-radius:6px; padding:1px 6px; font:500 .88em/1.4 var(--mono)}
.manifesto{font-size:clamp(32px,4.8vw,64px); font-weight:700; letter-spacing:-.05em; line-height:1.05; max-width:20ch}
.manifesto .soft{color:var(--ink-3)}
.vals{display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,2vw,24px)}
@media (max-width:880px){ .vals{grid-template-columns:1fr} }
.vals article{border-top:1px solid var(--ink); padding-top:24px; display:grid; gap:12px; align-content:start}
.vals h3{font-size:24px; letter-spacing:-.03em}
.vals p{color:var(--ink-2)}
.team{display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,2vw,24px)}
@media (max-width:880px){ .team{grid-template-columns:1fr 1fr} }
@media (max-width:520px){ .team{grid-template-columns:1fr} }
.member{display:grid; gap:12px}
.member .pic{aspect-ratio:4/5; border-radius:20px; background:var(--bg-2); border:1px dashed var(--line-2); display:grid; place-items:center; font:500 13px/1.4 var(--mono); color:var(--ink-3); text-align:center}
.member h3{font-size:20px; letter-spacing:-.02em}
.member p{color:var(--ink-2); font-size:15px}
.big{font-size:clamp(52px,8.4vw,128px); font-weight:800; letter-spacing:-.065em; line-height:.9}
.big .soft{color:var(--ink-3)}
.contact-grid{display:grid; grid-template-columns:.95fr 1.05fr; gap:clamp(28px,5vw,80px); align-items:start}
@media (max-width:940px){ .contact-grid{grid-template-columns:1fr} }
.card{border:1px solid var(--line); border-radius:28px; padding:clamp(22px,3.4vw,40px); box-shadow:var(--float); background:var(--bg)}
.chans{display:grid; gap:10px; margin-top:32px}
.chan{display:flex; justify-content:space-between; align-items:center; gap:16px; padding:18px 20px; border:1px solid var(--line); border-radius:16px; text-decoration:none; transition:border-color .15s, background .15s}
a.chan:hover{border-color:var(--ink); background:var(--bg-2)}
.chan b{display:block; font-size:17px; font-weight:600; letter-spacing:-.02em}
.chan span{font-size:14px; color:var(--ink-2)}
.promise{display:flex; gap:24px; flex-wrap:wrap; margin-top:28px}
.promise div{display:grid; gap:2px}
.promise b{font:600 20px/1 var(--mono); letter-spacing:-.04em}
.promise span{font-size:13px; color:var(--ink-3)}


/* ================= COOKIES ================= */
.ck{position:fixed; left:16px; right:16px; bottom:calc(16px + env(safe-area-inset-bottom,0px)); z-index:90; max-width:560px; margin-left:auto; background:var(--bg); color:var(--ink); border:1px solid var(--line); border-radius:22px; box-shadow:var(--float); padding:22px; display:grid; gap:14px; animation:in .35s cubic-bezier(.2,.7,.2,1) both}
.ck h2{font-size:19px; letter-spacing:-.02em; font-weight:700}
.ck p{font-size:14px; line-height:1.5; color:var(--ink-2)}
.ck p a{color:var(--ink)}
.ck-btns{display:grid; grid-template-columns:1fr 1fr; gap:8px}
.ck-btns .btn{padding:14px 12px; font-size:15px}
.ck-cfg-btn{background:none; border:0; color:var(--ink-2); font:500 14px/1 var(--sans); text-decoration:underline; text-underline-offset:3px; cursor:pointer; justify-self:start; padding:4px 0}
.ck-opts{display:grid; gap:0; border-top:1px solid var(--line)}
.ck-opt{display:grid; grid-template-columns:1fr auto; gap:14px; align-items:center; padding:14px 0; border-bottom:1px solid var(--line)}
.ck-opt b{font-size:15px; font-weight:600; display:block}
.ck-opt span{font-size:13px; color:var(--ink-2); line-height:1.45; display:block; margin-top:2px}
.sw{position:relative; width:46px; height:28px; flex:none}
.sw input{position:absolute; inset:0; opacity:0; margin:0; cursor:pointer; z-index:1}
.sw i{position:absolute; inset:0; border-radius:999px; background:var(--bg-3); border:1px solid var(--line-2); transition:background .2s}
.sw i::after{content:""; position:absolute; top:3px; left:3px; width:20px; height:20px; border-radius:50%; background:var(--bg); box-shadow:0 1px 3px rgba(0,0,0,.25); transition:transform .2s}
.sw input:checked + i{background:var(--ink); border-color:var(--ink)}
.sw input:checked + i::after{transform:translateX(18px)}
.sw input:disabled + i{opacity:.55}
.sw input:focus-visible + i{outline:2px solid var(--ink); outline-offset:2px}
@media (max-width:880px){ body.ck-open .mcta{display:none} }
.legal h2{font-size:24px; letter-spacing:-.03em; margin-top:18px; color:var(--ink)}
.legal table{width:100%; border-collapse:collapse; font-size:14px}
.legal th, .legal td{text-align:left; padding:12px 10px; border-bottom:1px solid var(--line); vertical-align:top}
.legal th{color:var(--ink); font-weight:600; background:var(--bg-2)}

/* ================= FOOTER ================= */
.foot{border-top:1px solid var(--line); padding-block:56px 40px}
.foot-grid{display:grid; grid-template-columns:1.5fr repeat(3,1fr); gap:28px}
@media (max-width:760px){ .foot-grid{grid-template-columns:1fr 1fr} }
.foot h4{font:500 12px/1 var(--mono); letter-spacing:.04em; color:var(--ink-3); margin-bottom:16px; text-transform:uppercase}
.foot ul{list-style:none; margin:0; padding:0; display:grid; gap:10px}
.foot a{text-decoration:none; color:var(--ink-2); font-size:15px}
.foot a:hover{color:var(--ink)}
.foot-b{display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-top:48px; padding-top:24px; border-top:1px solid var(--line); font-size:13px; color:var(--ink-3)}
.theme{background:none; border:1px solid var(--line-2); color:var(--ink-2); border-radius:8px; padding:8px 12px; font:500 12px/1 var(--mono); cursor:pointer}

/* floating mobile CTA */
.mcta{display:none}
