    $("#calGrid").innerHTML = html;
    $("#calTotal").textContent = eur(total);
    var k = $("#calDeltaK"), v = $("#calDelta");
    if (dyn){ k.textContent = "Frente a precio fijo"; v.textContent = "+" + eur(total - FIX*31); v.className = "num up"; }
    else { k.textContent = cheap + " noches vendidas baratas"; v.textContent = "−" + eur(lost); v.className = "num dn"; }
  }
  $("#tFix").addEventListener("click", function(){ dyn = false; this.setAttribute("aria-pressed","true"); $("#tDyn").setAttribute("aria-pressed","false"); drawCal(); });
  $("#tDyn").addEventListener("click", function(){ dyn = true; this.setAttribute("aria-pressed","true"); $("#tFix").setAttribute("aria-pressed","false"); drawCal(); });
  drawCal();

  /* ============ CALCULATOR ============ */
  // Misma fórmula que la Edge Function (el servidor la recalcula al guardar).
  var ZONAS = {abando:{adr:1.1,occ:.7}, casco:{adr:1.05,occ:.72}, bilbao_otro:{adr:.85,occ:.66}, costa:{adr:1,occ:.6}, euskadi:{adr:.9,occ:.62}};
  var DORMS = {1:.8, 2:1, 3:1.25, 4:1.5};
  var UPLIFT = {fijo:.22, manual:.15, plataforma:.12, gestora:.1, dinamica:.06, nose:.18};
  function estimar(s){
    var z = ZONAS[s.zona], adrM = 180 * z.adr * DORMS[s.dorm];
    var occ = s.ocup / 100, actual = s.precio * occ * 365;
    var adrPot = (s.precio + 0.35 * Math.max(0, adrM - s.precio)) * (1 + UPLIFT[s.metodo] * 0.6);
    var occPot = Math.max(occ, z.occ * 0.95); if (occ > .85) occPot = occ - .04; occPot = Math.min(occPot, .92);
    var pot = Math.min(Math.max(adrPot * occPot * 365, actual * 1.05), actual * 1.45);
    return {actual:Math.round(actual), potencial:Math.round(pot), mejora:Math.round(pot - actual)};
  }

  var S = {step:1, zona:null, dorm:2, precio:120, ocup:70, metodo:null, registro:null, n_alojamientos:null, franja:"manana"};
  var LABELS = {1:"1 / 3 · Zona", 2:"2 / 3 · Tu piso", 3:"3 / 3 · Tus precios", 4:"Resultado"};

  function press(group, value){
    $$(group + " [data-v]").forEach(function(b){ b.setAttribute("aria-pressed", b.getAttribute("data-v") === String(value) ? "true" : "false"); });
  }
  function pick(group, key, cb){
    $$(group + " [data-v]").forEach(function(b){
      b.addEventListener("click", function(){
        var v = b.getAttribute("data-v");
        S[key] = key === "dorm" ? Number(v) : v;
        press(group, v);
        var f = b.closest(".f"); if (f) f.classList.remove("bad");
        if (cb) cb();
      });
    });
  }
  pick("#zonaOpts", "zona", function(){ sync(); setTimeout(function(){ go(2); }, 240); });
  pick("#dormSeg", "dorm");
  pick("#metodoOpts", "metodo", function(){ sync(); setTimeout(function(){ go(4); }, 240); });
  pick("#regSeg", "registro");
  pick("#alSeg", "n_alojamientos");
  pick("#frSeg", "franja");

  var rp = $("#precio"), ro = $("#ocup");
  function fill(el){ el.style.setProperty("--fill", ((el.value - el.min) / (el.max - el.min) * 100) + "%"); }
  function onRange(){
    S.precio = Number(rp.value); S.ocup = Number(ro.value);
    $("#precioOut").textContent = S.precio + " €";
    $("#ocupOut").textContent = S.ocup + " %";
    $("#ocupHint").textContent = "≈ " + Math.round(S.ocup / 100 * 365) + " noches. La media de Bilbao está en el 68 %.";
    fill(rp); fill(ro);
  }
  rp.addEventListener("input", onRange); ro.addEventListener("input", onRange); onRange();

  function canNext(){ return S.step === 1 ? !!S.zona : S.step === 2 ? true : S.step === 3 ? !!S.metodo : false; }
  function sync(){
    $("#nextBtn").disabled = !canNext();
    $("#backBtn").hidden = S.step === 1;
    $("#nextBtn").hidden = S.step === 4;
    $("#nextBtn").firstElementChild.textContent = S.step === 3 ? "Ver mi resultado" : "Siguiente";
    $("#calcMeter").textContent = LABELS[S.step];
    $("#barFill").style.width = (S.step >= 4 ? 100 : S.step * 33.4) + "%";
  }
  function go(n, noScroll){
    S.step = n;
    $$("[data-step]").forEach(function(el){ el.hidden = Number(el.getAttribute("data-step")) !== n; });
    sync();
    if (n === 4) result();
    if (!noScroll){
      var top = $("#calc").getBoundingClientRect().top;
      if (top < 40 || top > innerHeight * 0.5) scrollToEl($("#calc"));
    }
  }
  $("#nextBtn").addEventListener("click", function(){ if (canNext()) go(S.step === 3 ? 4 : S.step + 1); });
  $("#backBtn").addEventListener("click", function(){ go(Math.max(1, S.step - 1)); });

  /* hero estimator → salta al paso 2 con los datos ya puestos */
  $("#est").addEventListener("submit", function(e){
    e.preventDefault();
    S.zona = $("#eZona").value; press("#zonaOpts", S.zona);
    S.dorm = Number($("#eDorm").value); press("#dormSeg", S.dorm);
    var p = Math.round((Number($("#ePrecio").value) || 120) / 5) * 5; p = Math.min(400, Math.max(40, p));
    rp.value = p; onRange();
    go(2, true);
    setHash("#/inicio/calculadora");
    requestAnimationFrame(function(){ scrollToEl($("#calc")); });
  });

  function countUp(el, to, ms){
    if (reduce){ el.textContent = eur(to); return; }
    var t0 = performance.now();
    (function tick(t){ var k = Math.min(1, (t - t0) / ms), e = 1 - Math.pow(1 - k, 3); el.textContent = eur(to * e); if (k < 1) requestAnimationFrame(tick); })(t0);
  }
  var SMAX = 80000;
  function pct(v){ return Math.max(2, Math.min(98, v / SMAX * 100)); }
  (function(){ var h = ""; [[22110,"25 % peor"],[44839,"Mediana"],[63809,"10 % mejor"]].forEach(function(m){ h += '<span style="left:'+pct(m[0])+'%">'+fmt.format(m[0])+' €<br>'+m[1]+'</span>'; }); $("#ticks").innerHTML = h; })();

  function result(){
    var r = estimar(S);
    countUp($("#rPot"), r.potencial, 1100);
    $("#rDelta").textContent = "↑ +" + Math.round(r.mejora / r.actual * 100) + " % frente a hoy";
    $("#rNow").textContent = eur(r.actual);
    $("#rGap").textContent = eur(r.mejora);
    $("#rMonth").textContent = "+" + eur(r.mejora / 12);
    $("#rPos").textContent = r.actual < 22110 ? "Hoy estás en el 25 % de pisos de Bilbao que menos factura." : r.actual < 44839 ? "Hoy estás por debajo de la mediana de Bilbao." : r.actual < 63809 ? "Hoy estás por encima de la mediana de Bilbao." : "Hoy estás en el 10 % de pisos que más factura en Bilbao.";
    $("#pinNow").style.left = "2%"; $("#pinPot").style.left = "2%";
    requestAnimationFrame(function(){ requestAnimationFrame(function(){ $("#pinNow").style.left = pct(r.actual) + "%"; $("#pinPot").style.left = pct(r.potencial) + "%"; }); });
  }

  /* ============ FORMS → SUPABASE ============ */
  function normTel(v){ var t = String(v || "").replace(/[^\d+]/g, ""); if (/^\d{9}$/.test(t)) t = "+34" + t; return t; }
  function validate(root, d){
    var ok = true;
    function mark(name, bad){ var f = root.querySelector('[data-f="' + name + '"]'); if (f) f.classList.toggle("bad", bad); if (bad) ok = false; }
    mark("nombre", (d.nombre || "").length < 2);
    mark("telefono", !/^\+?\d{9,15}$/.test(d.telefono));
    mark("email", !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(d.email || ""));
    mark("registro", !d.registro);
    mark("n_alojamientos", !d.n_alojamientos);
    return ok;
  }
  function send(payload){
    return fetch(API, {method:"POST", headers:{"Content-Type":"application/json"}, body:JSON.stringify(payload)})
      .then(function(r){ return r.json().catch(function(){ return {}; }).then(function(j){ return {ok:r.ok, j:j}; }); });
  }
  function submitFlow(opts){
    var btn = opts.btn, label = btn.firstElementChild, msg = opts.msg, orig = label.textContent;
    msg.hidden = true;
    var d = opts.data;
    Object.keys(utm).forEach(function(k){ d[k] = utm[k]; });
    var valid = validate(opts.form, d);
    opts.consentWrap.classList.toggle("bad", !d.consentimiento);
    if (!valid || !d.consentimiento){ msg.textContent = "Revisa los campos marcados en rojo."; msg.hidden = false; return; }
    btn.disabled = true; label.textContent = "Enviando…";
    send(d).then(function(res){
      if (!res.ok || !res.j.ok) throw new Error((res.j && res.j.error) || "Error");
      opts.onOk(d);
    }).catch(function(err){
      msg.textContent = err && err.message && err.message !== "Failed to fetch" && err.message !== "Error" ? err.message : "No hemos podido enviar tus datos. Comprueba tu conexión e inténtalo de nuevo.";
      msg.hidden = false;
    }).then(function(){ btn.disabled = false; label.textContent = orig; });
  }

  $("#leadForm").addEventListener("submit", function(e){
    e.preventDefault();
    submitFlow({
      form:this, btn:$("#leadBtn"), msg:$("#leadMsg"), consentWrap:$("#lConsentWrap"),
      data:{
        tipo:"calculadora", nombre:$("#lNombre").value.trim(), telefono:normTel($("#lTel").value), email:$("#lEmail").value.trim(),
        zona:S.zona, dormitorios:S.dorm, metodo_precio:S.metodo, precio_noche:S.precio, ocupacion:S.ocup / 100,
        registro:S.registro, n_alojamientos:S.n_alojamientos, anuncio_url:$("#lAnuncio").value.trim(), franja:S.franja,
        consentimiento:$("#lConsent").checked, consentimiento_texto:$("#lConsentTxt").textContent.trim(),
        web_empresa:$("#lWeb").value, pagina:location.href.slice(0, 200)
      },
      onOk:function(d){
        $("#gateForm").hidden = true; $("#gateOk").hidden = false;
        $("#okTitle").textContent = "Recibido, " + d.nombre.split(" ")[0] + ".";
        $("#okText").textContent = d.registro === "no"
          ? "Te enviaremos por email una guía sobre el registro turístico. Cuando tu piso esté inscrito, preparamos el informe."
          : "Te llamaremos por la " + ({manana:"mañana", mediodia:"hora de comer", tarde:"tarde"})[d.franja] + ", en menos de 24 horas laborables.";
        try { if (window.fbq) window.fbq("track", "Lead"); } catch(_){}
      }
    });
  });

  /* ============ TARIFAS (segmentos) ============ */
  var TARIFAS = {
    piso:   {fijo:"79 €", k:"al mes por piso", v:"15 %", min:"—", alta:"0 €", ej:"1 piso: 79 € fijos al mes", cta:"Ver cuánto podría mejorar mi piso", href:"#/inicio/calculadora"},
    gestora:{fijo:"65 €", k:"al mes por piso, desde 4 pisos", v:"12 %", min:"260 €", alta:"0 €", ej:"8 pisos: 520 € fijos al mes", cta:"Pedir propuesta para mi cartera", href:"#/contacto"},
    hostal: {fijo:"39 €", k:"al mes por habitación", v:"10 %", min:"390 €", alta:"290 €", ej:"18 habitaciones: 702 € fijos al mes", cta:"Pedir propuesta para mi hostal", href:"#/contacto"},
    hotel:  {fijo:"35 €", k:"al mes por habitación", v:"10 %", min:"990 €", alta:"690 €", ej:"60 habitaciones: 2.100 € fijos al mes", cta:"Pedir propuesta para mi hotel", href:"#/contacto"}
  };
  function setSeg(k){
    var t = TARIFAS[k]; if (!t) return;
    $$(".seg-tabs [data-seg]").forEach(function(b){ b.setAttribute("aria-selected", String(b.getAttribute("data-seg") === k)); });
    $("#tFijo").textContent = t.fijo; $("#tFijoK").textContent = t.k; $("#tVar").textContent = t.v;
    $("#tMin").textContent = t.min; $("#tAlta").textContent = t.alta; $("#tEj").textContent = t.ej;
    var a = $("#tCta"); a.setAttribute("href", t.href); a.setAttribute("data-tipo", k); a.firstChild.nodeValue = t.cta + " ";
  }
  $$(".seg-tabs [data-seg]").forEach(function(b){ b.addEventListener("click", function(){ setSeg(b.getAttribute("data-seg")); }); });

  var C = {tipo_aloj:null, registro:null, n_alojamientos:null};
  // enlaces con data-tipo preseleccionan el tipo en el formulario de contacto
  document.addEventListener("click", function(e){
    var a = e.target.closest && e.target.closest("a[data-tipo]"); if (!a) return;
    var v = a.getAttribute("data-tipo"); C.tipo_aloj = v; press("#cTipoSeg", v);
  }, true);
  function cPick(group, key){ $$(group + " [data-v]").forEach(function(b){ b.addEventListener("click", function(){ C[key] = b.getAttribute("data-v"); press(group, C[key]); b.closest(".f").classList.remove("bad"); }); }); }
  cPick("#cTipoSeg", "tipo_aloj"); cPick("#cRegSeg", "registro"); cPick("#cAlSeg", "n_alojamientos");
  $("#contactForm").addEventListener("submit", function(e){
    e.preventDefault();
    submitFlow({
      form:this, btn:$("#cBtn"), msg:$("#cMsgBox"), consentWrap:$("#cConsentWrap"),
      data:{
        tipo:"contacto", tipo_aloj:C.tipo_aloj, nombre:$("#cNombre").value.trim(), telefono:normTel($("#cTel").value), email:$("#cEmail").value.trim(),
        registro:C.registro, n_alojamientos:C.n_alojamientos, mensaje:((C.tipo_aloj ? "[Tipo: " + C.tipo_aloj + "] " : "") + $("#cMsg").value.trim()).slice(0, 1000),
        consentimiento:$("#cConsent").checked, consentimiento_texto:$("#cConsentTxt").textContent.trim(),
        web_empresa:$("#cWeb").value, pagina:location.href.slice(0, 200)
      },
      onOk:function(){ $("#cFormWrap").hidden = true; $("#cOk").hidden = false; try { if (window.fbq) window.fbq("track", "Contact"); } catch(_){} }
    });
  });

  /* ============ COOKIES + META PIXEL ============
     El Pixel solo se carga si el usuario acepta marketing (guía AEPD).
     Pega tu ID en META_PIXEL_ID cuando lo tengas; si está vacío, no se carga nada. */
  var META_PIXEL_ID = "";
  var CK_KEY = "rms_consent", CK_VERSION = 1, CK_DAYS = 365;
  function readConsent(){
    try { var c = JSON.parse(localStorage.getItem(CK_KEY) || "null"); if (c && c.v === CK_VERSION && Date.now() - c.t < CK_DAYS*864e5) return c; } catch(e){}
    return null;
  }
  function saveConsent(mkt){ var c = {v:CK_VERSION, t:Date.now(), marketing:!!mkt}; try { localStorage.setItem(CK_KEY, JSON.stringify(c)); } catch(e){} return c; }
  var pixelLoaded = false;
  function loadPixel(){
    if (pixelLoaded || !META_PIXEL_ID) return;
    pixelLoaded = true;
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    window.fbq("consent", "grant");
    window.fbq("init", META_PIXEL_ID);
    window.fbq("track", "PageView");
  }
  function revokePixel(){
    try { if (window.fbq) window.fbq("consent", "revoke"); } catch(e){}
    // borra cookies de Meta ya instaladas
    ["_fbp","_fbc"].forEach(function(n){ document.cookie = n + "=; Max-Age=0; path=/"; document.cookie = n + "=; Max-Age=0; path=/; domain=" + location.hostname.replace(/^www\./, "."); });
  }
  function openCk(showOpts){
    var c = readConsent();
    $("#ckMkt").checked = !!(c && c.marketing);
    $("#ckOpts").hidden = !showOpts;
    $("#ckCfg").textContent = showOpts ? "Guardar selección" : "Configurar";
    $("#ck").hidden = false; document.body.classList.add("ck-open");
  }
  function closeCk(){ $("#ck").hidden = true; document.body.classList.remove("ck-open"); }
  function apply(mkt){ saveConsent(mkt); if (mkt) loadPixel(); else revokePixel(); closeCk(); }
  $("#ckAccept").addEventListener("click", function(){ apply(true); });
  $("#ckReject").addEventListener("click", function(){ apply(false); });
  $("#ckCfg").addEventListener("click", function(){ if ($("#ckOpts").hidden) openCk(true); else apply($("#ckMkt").checked); });
  document.addEventListener("click", function(e){ var b = e.target.closest && e.target.closest("[data-open-cookies]"); if (b){ e.preventDefault(); openCk(true); } });
  (function(){ var c = readConsent(); if (!c) openCk(false); else if (c.marketing) loadPixel(); })();

  sync();
  show(location.hash || "#/inicio");
})();
</script>
