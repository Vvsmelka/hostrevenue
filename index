.faq{border-top:1px solid var(--line)}
.faq details{border-bottom:1px solid var(--line)}
.faq summary{list-style:none; cursor:pointer; display:flex; justify-content:space-between; align-items:center; gap:20px; padding:22px 0; font:600 18px/1.35 var(--sans); letter-spacing:-.02em}
.faq summary::-webkit-details-marker{display:none}
.faq summary .pm{flex:none; width:28px; height:28px; border-radius:50%; border:1px solid var(--line-2); position:relative; transition:transform .25s, background .2s}
.faq summary .pm::before, .faq summary .pm::after{content:""; position:absolute; left:50%; top:50%; width:10px; height:1.5px; background:var(--ink); transform:translate(-50%,-50%)}
.faq summary .pm::after{transform:translate(-50%,-50%) rotate(90deg)}
.faq details[open] .pm{transform:rotate(45deg); background:var(--bg-2)}
.faq details p{padding:0 48px 24px 0; color:var(--ink-2)}
