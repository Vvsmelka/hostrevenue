<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Revenue Managers Spain</title>
<meta name="description" content="Revenue management para propietarios de viviendas turísticas. Calcula en 60 segundos cuánto podría facturar tu piso.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap">
<style>
/* ================= TOKENS ================= */
:root{
  --bg:#FFFFFF; --bg-2:#F6F6F3; --bg-3:#EDEDE8;
  --ink:#0B0B0A; --ink-2:#55554F; --ink-3:#8C8C85; --line:#E4E4DE; --line-2:#CFCFC7;
  --btn:#0B0B0A; --btn-ink:#FFFFFF; --btn-hover:#2A2A27;
  --up:#0A8754; --up-soft:#E3F3EB;
  --down:#B5620C; --down-soft:#FBEEDD;
  --err:#C0271D;
  --inv-bg:#0B0B0A; --inv-ink:#F4F4EF; --inv-2:#A3A39B; --inv-line:#262623; --inv-card:#151513;
  --sans:"Geist", "Helvetica Neue", Helvetica, Arial, sans-serif;
  --mono:"Geist Mono", ui-monospace, "SF Mono", Menlo, monospace;
  --max:1200px;
  --lift:0 1px 2px rgba(0,0,0,.04), 0 8px 24px -8px rgba(0,0,0,.12);
  --float:0 2px 4px rgba(0,0,0,.04), 0 24px 60px -20px rgba(0,0,0,.28);
  --hdr:72px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0B0B0A; --bg-2:#131311; --bg-3:#1B1B19;
    --ink:#F4F4EF; --ink-2:#AEAEA6; --ink-3:#77776F; --line:#23231F; --line-2:#34342F;
    --btn:#F4F4EF; --btn-ink:#0B0B0A; --btn-hover:#DADAD3;
    --up:#3CCB8A; --up-soft:#0F2A1D; --down:#F0A24E; --down-soft:#2C1D0C; --err:#FF7B72;
    --inv-bg:#F4F4EF; --inv-ink:#0B0B0A; --inv-2:#55554F; --inv-line:#DCDCD5; --inv-card:#FFFFFF;
    --lift:0 1px 2px rgba(0,0,0,.4), 0 8px 24px -8px rgba(0,0,0,.6);
    --float:0 2px 4px rgba(0,0,0,.4), 0 24px 60px -20px rgba(0,0,0,.8);
  }
}
:root[data-theme="dark"]{
  --bg:#0B0B0A; --bg-2:#131311; --bg-3:#1B1B19;
  --ink:#F4F4EF; --ink-2:#AEAEA6; --ink-3:#77776F; --line:#23231F; --line-2:#34342F;
  --btn:#F4F4EF; --btn-ink:#0B0B0A; --btn-hover:#DADAD3;
  --up:#3CCB8A; --up-soft:#0F2A1D; --down:#F0A24E; --down-soft:#2C1D0C; --err:#FF7B72;
  --inv-bg:#F4F4EF; --inv-ink:#0B0B0A; --inv-2:#55554F; --inv-line:#DCDCD5; --inv-card:#FFFFFF;
  --lift:0 1px 2px rgba(0,0,0,.4), 0 8px 24px -8px rgba(0,0,0,.6);
  --float:0 2px 4px rgba(0,0,0,.4), 0 24px 60px -20px rgba(0,0,0,.8);
}

/* ================= BASE ================= */
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0; background:var(--bg); color:var(--ink); font:400 17px/1.55 var(--sans); -webkit-font-smoothing:antialiased; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px)}
img{max-width:100%}
[hidden]{display:none!important}
a{color:inherit}
h1,h2,h3,h4{margin:0; font-weight:700; letter-spacing:-.035em; line-height:1.02; text-wrap:balance}
p{margin:0}
.num{font-family:var(--mono); font-variant-numeric:tabular-nums; letter-spacing:-.03em}
.wrap{max-width:var(--max); margin-inline:auto; padding-inline:clamp(16px,4vw,40px)}
.muted{color:var(--ink-2)}
.faint{color:var(--ink-3)}
.lead{font-size:clamp(18px,1.55vw,21px); line-height:1.5; color:var(--ink-2); max-width:54ch}
:focus-visible{outline:2px solid var(--ink); outline-offset:3px; border-radius:6px}
[id]{scroll-margin-top:calc(var(--hdr) + 16px)}
@media (prefers-reduced-motion: reduce){ *{animation:none!important; transition:none!important} }

/* ================= BUTTONS ================= */
.btn{display:inline-flex; align-items:center; justify-content:center; gap:10px; font:600 16px/1 var(--sans); letter-spacing:-.01em; padding:17px 22px; border-radius:12px; border:1px solid transparent; cursor:pointer; text-decoration:none; white-space:nowrap; transition:background .18s, color .18s, border-color .18s, transform .12s}
.btn:active{transform:scale(.985)}
.btn-dark{background:var(--btn); color:var(--btn-ink)}
.btn-dark:hover{background:var(--btn-hover)}
.btn-line{background:transparent; color:var(--ink); border-color:var(--line-2)}
.btn-line:hover{border-color:var(--ink)}
.btn-sm{padding:12px 16px; font-size:15px; border-radius:10px}
.btn-block{width:100%}
.btn .arr{display:inline-block; transition:transform .18s}
.btn:hover .arr{transform:translateX(3px)}
.btn[disabled]{opacity:.35; cursor:not-allowed}

/* ================= HEADER ================= */
.hdr{position:sticky; top:env(safe-area-inset-top,0px); z-index:60; background:color-mix(in srgb, var(--bg) 86%, transparent); backdrop-filter:saturate(1.6) blur(16px); -webkit-backdrop-filter:saturate(1.6) blur(16px); border-bottom:1px solid transparent; transition:border-color .2s}
.hdr.on{border-bottom-color:var(--line)}
.nav{height:var(--hdr); display:flex; align-items:center; gap:24px}
.logo{display:flex; align-items:center; gap:10px; text-decoration:none; flex:none}
.logo .mk{width:30px; height:30px; border-radius:8px; background:var(--ink); color:var(--bg); display:grid; place-items:center; font:700 12px/1 var(--mono); letter-spacing:-.04em}
.logo .wm{font:700 16px/1.05 var(--sans); letter-spacing:-.03em}
.logo .wm span{display:block; font:500 11px/1.2 var(--mono); letter-spacing:.06em; color:var(--ink-3); text-transform:uppercase}
.links{display:flex; gap:2px; list-style:none; margin:0 0 0 12px; padding:0}
.links a{display:block; padding:10px 14px; border-radius:10px; text-decoration:none; font-weight:500; font-size:15px; color:var(--ink-2); transition:color .15s, background .15s}
.links a:hover{color:var(--ink); background:var(--bg-2)}
.links a[aria-current="page"]{color:var(--ink)}
.links a[aria-current="page"]::after{content:""; display:block; height:2px; background:var(--ink); border-radius:2px; margin-top:6px}
.nav .grow{flex:1}
.burger{display:none; width:44px; height:44px; border-radius:10px; border:1px solid var(--line-2); background:transparent; color:var(--ink); cursor:pointer; place-items:center}
@media (max-width:880px){
  .links, .nav .btn{display:none}
  .burger{display:grid}
  .links.open{display:flex; flex-direction:column; position:absolute; left:0; right:0; top:var(--hdr); margin:0; background:var(--bg); padding:8px 16px 24px; border-bottom:1px solid var(--line); box-shadow:var(--lift)}
  .links.open a{font-size:22px; font-weight:600; padding:16px 6px; letter-spacing:-.02em; color:var(--ink)}
  .links.open a[aria-current="page"]::after{display:none}
}

/* ================= LAYOUT ================= */
.sec{padding-block:clamp(72px,10vw,136px)}
.sec-sm{padding-block:clamp(48px,6vw,80px)}
.h-sec{font-size:clamp(36px,5.2vw,68px); letter-spacing:-.045em}
.h-sub{margin-top:18px}
.head{display:flex; justify-content:space-between; align-items:end; gap:32px; flex-wrap:wrap; margin-bottom:clamp(36px,5vw,64px)}
.head > div{max-width:720px}
.page{animation:in .4s cubic-bezier(.2,.7,.2,1) both}
@keyframes in{from{opacity:.001; transform:translateY(6px)} to{opacity:1; transform:none}}
.tag{display:inline-flex; align-items:center; gap:8px; font:500 13px/1 var(--mono); color:var(--ink-2); background:var(--bg-2); border:1px solid var(--line); padding:8px 12px; border-radius:999px}
.tag i{width:7px; height:7px; border-radius:50%; background:var(--up); box-shadow:0 0 0 3px color-mix(in srgb, var(--up) 22%, transparent)}

/* ================= HERO ================= */
.hero{padding-block:clamp(40px,6vw,88px) clamp(56px,7vw,104px)}
.hero-grid{display:grid; grid-template-columns:1.12fr .88fr; gap:clamp(36px,6vw,88px); align-items:center}
@media (max-width:980px){ .hero-grid{grid-template-columns:1fr} }
.hero h1{font-size:clamp(52px,8vw,112px); font-weight:800; letter-spacing:-.06em; line-height:.92; margin-top:26px}
.hero h1 .soft{color:var(--ink-3)}
.hero .lead{margin-top:28px}
.proof{display:grid; grid-template-columns:repeat(3,auto); justify-content:start; gap:clamp(20px,3vw,36px); margin-top:40px; padding-top:28px; border-top:1px solid var(--line)}
.proof div{display:grid; gap:4px}
.proof b{font:600 22px/1 var(--mono); letter-spacing:-.04em}
.proof span{font-size:13px; color:var(--ink-3)}

/* estimator (Uber fare-style) */
.est{background:var(--bg); border:1px solid var(--line); border-radius:24px; padding:clamp(20px,2.6vw,28px); box-shadow:var(--float)}
.est h2{font-size:26px; letter-spacing:-.035em}
.est p.muted{margin-top:6px; font-size:15px}
.est-fields{margin-top:22px; border:1px solid var(--line-2); border-radius:16px; overflow:hidden; background:var(--bg-2)}
.ef{position:relative; display:grid; grid-template-columns:36px 1fr; align-items:center; padding:0 16px 0 12px; border-bottom:1px solid var(--line-2); background:var(--bg)}
.ef:last-child{border-bottom:0}
.ef .ic{width:24px; height:24px; display:grid; place-items:center; color:var(--ink)}
.ef label{position:absolute; left:48px; top:12px; font:500 12px/1 var(--sans); color:var(--ink-3)}
.ef select, .ef input{appearance:none; -webkit-appearance:none; border:0; background:transparent; color:var(--ink); font:600 17px/1.2 var(--sans); padding:30px 0 12px; width:100%; outline:none; cursor:pointer; letter-spacing:-.01em}
.ef input{cursor:text}
.ef .suf{position:absolute; right:16px; bottom:13px; font:600 17px/1 var(--sans); color:var(--ink-3); pointer-events:none}
.ef .chev{position:absolute; right:16px; bottom:16px; pointer-events:none; color:var(--ink-3)}
.ef:focus-within{background:var(--bg-2)}
.est .btn{margin-top:14px}
.est-foot{display:flex; align-items:center; gap:8px; margin-top:14px; font-size:13px; color:var(--ink-3)}

/* ================= STATS ROW ================= */
.stats{display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--line); border-bottom:1px solid var(--line)}
@media (max-width:880px){ .stats{grid-template-columns:repeat(2,1fr)} }
.stat{padding:28px 24px 28px 0; display:grid; gap:10px}
.stat + .stat{padding-left:24px; border-left:1px solid var(--line)}
@media (max-width:880px){ .stat:nth-child(3){padding-left:0; border-left:0} .stat:nth-child(n+3){border-top:1px solid var(--line)} }
.stat b{font:600 clamp(30px,3.6vw,46px)/1 var(--mono); letter-spacing:-.05em}
.stat span{font-size:14px; color:var(--ink-2); max-width:24ch}
.src{margin-top:14px; font-size:12px; color:var(--ink-3)}

/* ================= DARK DEMO ================= */
.inv{background:var(--inv-bg); color:var(--inv-ink)}
.inv .muted{color:var(--inv-2)}
.demo-grid{display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(36px,6vw,88px); align-items:center}
@media (max-width:980px){ .demo-grid{grid-template-columns:1fr} }
.seg-dark{display:inline-flex; padding:4px; border-radius:12px; background:var(--inv-card); border:1px solid var(--inv-line); margin-top:32px}
.seg-dark button{border:0; background:transparent; color:var(--inv-2); font:600 15px/1 var(--sans); padding:12px 16px; border-radius:9px; cursor:pointer}
.seg-dark button[aria-pressed="true"]{background:var(--inv-ink); color:var(--inv-bg)}
.demo-kpis{display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--inv-line); border:1px solid var(--inv-line); border-radius:16px; overflow:hidden; margin-top:28px}
.demo-kpis div{background:var(--inv-bg); padding:20px}
.demo-kpis span{display:block; font-size:13px; color:var(--inv-2)}
.demo-kpis b{display:block; margin-top:8px; font:600 clamp(24px,2.6vw,32px)/1 var(--mono); letter-spacing:-.04em}
.demo-kpis b.dn{color:var(--down)}
.demo-kpis b.up{color:var(--up)}
.phone{background:var(--inv-card); border:1px solid var(--inv-line); border-radius:28px; padding:clamp(16px,2.4vw,26px)}
.ph-top{display:flex; justify-content:space-between; align-items:center; margin-bottom:18px; gap:12px}
.ph-top b{font-size:17px; letter-spacing:-.02em}
.ph-top span{font:500 12px/1 var(--mono); color:var(--inv-2)}
.dow, .grid{display:grid; grid-template-columns:repeat(7,1fr); gap:6px}
.dow{margin-bottom:8px}
.dow span{text-align:center; font:500 11px/1 var(--mono); color:var(--inv-2)}
.cell{aspect-ratio:1/1.08; border-radius:10px; background:color-mix(in srgb, var(--inv-ink) 5%, transparent); padding:6px 7px; display:flex; flex-direction:column; justify-content:space-between; position:relative; transition:background .35s}
.cell .d{font:500 10px/1 var(--mono); color:var(--inv-2)}
.cell .p{font:600 clamp(10px,1.1vw,13px)/1 var(--mono); letter-spacing:-.04em}
.cell.low{background:color-mix(in srgb, var(--down) 18%, transparent)}
.cell.low .p{color:var(--down)}
.cell.hi{background:color-mix(in srgb, var(--up) 16%, transparent)}
.cell.hi .p{color:var(--up)}
.cell .ev{position:absolute; top:6px; right:6px; width:5px; height:5px; border-radius:50%; background:var(--inv-ink)}
.cell.off{background:transparent}
.ph-legend{display:flex; gap:16px; flex-wrap:wrap; margin-top:16px; font-size:12px; color:var(--inv-2)}
.ph-legend i{display:inline-block; width:9px; height:9px; border-radius:3px; margin-right:6px; vertical-align:0}

/* ================= LEAKS ================= */
.leaks{display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,2vw,24px)}
@media (max-width:880px){ .leaks{grid-template-columns:1fr} }
.leak{border-top:1px solid var(--ink); padding-top:24px; display:grid; gap:14px; align-content:start}
.leak .big{font:600 clamp(40px,4.4vw,56px)/1 var(--mono); letter-spacing:-.06em; color:var(--down)}
.leak .big small{font-size:.32em; letter-spacing:0; color:var(--ink-3); margin-left:6px; font-family:var(--sans); font-weight:500}
.leak h3{font-size:24px; letter-spacing:-.03em}
.leak p{color:var(--ink-2)}

/* ================= CALCULATOR ================= */
.calc-sec{background:var(--bg-2)}
.calc{background:var(--bg); border:1px solid var(--line); border-radius:28px; box-shadow:var(--lift); overflow:hidden}
.calc-top{display:flex; justify-content:space-between; align-items:center; gap:16px; padding:18px clamp(18px,3vw,32px); border-bottom:1px solid var(--line)}
.bar{flex:1; max-width:360px; height:4px; background:var(--bg-3); border-radius:4px; overflow:hidden}
.bar i{display:block; height:100%; width:33%; background:var(--ink); border-radius:4px; transition:width .45s cubic-bezier(.2,.7,.2,1)}
.calc-meter{font:500 13px/1 var(--mono); color:var(--ink-3); white-space:nowrap}
.calc-body{padding:clamp(24px,4.4vw,56px) clamp(18px,3vw,32px) clamp(20px,3vw,32px)}
.step{animation:in .35s cubic-bezier(.2,.7,.2,1) both}
.q{font-size:clamp(28px,3.6vw,44px); letter-spacing:-.045em}
.q-sub{margin-top:10px; color:var(--ink-2)}
.opts{display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:10px; margin-top:30px}
.opt{position:relative; text-align:left; border:1.5px solid var(--line); background:var(--bg); color:var(--ink); border-radius:16px; padding:18px 44px 18px 18px; cursor:pointer; font:inherit; display:grid; gap:4px; transition:border-color .15s, background .15s, box-shadow .15s}
.opt:hover{border-color:var(--line-2); box-shadow:var(--lift)}
.opt[aria-pressed="true"]{border-color:var(--ink); background:var(--bg-2); box-shadow:inset 0 0 0 1px var(--ink)}
.opt strong{font-size:17px; font-weight:600; letter-spacing:-.02em}
.opt span{font-size:14px; color:var(--ink-2); line-height:1.4}
.opt .rad{position:absolute; top:18px; right:16px; width:20px; height:20px; border-radius:50%; border:1.5px solid var(--line-2); transition:border .15s}
.opt[aria-pressed="true"] .rad{border:6px solid var(--ink)}
.chips{display:flex; flex-wrap:wrap; gap:8px; margin-top:12px}
.chips button{border:1.5px solid var(--line); background:var(--bg); color:var(--ink); border-radius:12px; padding:12px 18px; font:600 15px/1 var(--sans); cursor:pointer; min-width:56px; transition:border-color .15s, background .15s}
.chips button:hover{border-color:var(--line-2)}
.chips button[aria-pressed="true"]{border-color:var(--ink); background:var(--ink); color:var(--bg)}
.fb{margin-top:36px}
.fl{display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap}
.fl label, .fl .lbl{font:600 16px/1.3 var(--sans)}
.fl output{font:600 clamp(30px,3.8vw,46px)/1 var(--mono); letter-spacing:-.05em}
.hint{font-size:13px; color:var(--ink-3); margin-top:6px}
input[type=range]{-webkit-appearance:none; appearance:none; width:100%; height:36px; background:transparent; margin-top:8px; cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:4px; border-radius:4px; background:linear-gradient(90deg, var(--ink) var(--fill,50%), var(--bg-3) var(--fill,50%))}
input[type=range]::-moz-range-track{height:4px; border-radius:4px; background:var(--bg-3)}
input[type=range]::-moz-range-progress{height:4px; border-radius:4px; background:var(--ink)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none; width:28px; height:28px; margin-top:-12px; border-radius:50%; background:var(--bg); border:1px solid var(--line-2); box-shadow:0 2px 10px rgba(0,0,0,.22)}
input[type=range]::-moz-range-thumb{width:26px; height:26px; border-radius:50%; background:var(--bg); border:1px solid var(--line-2); box-shadow:0 2px 10px rgba(0,0,0,.22)}
.calc-nav{display:flex; align-items:center; gap:12px; margin-top:40px; padding-top:22px; border-top:1px solid var(--line)}
.calc-nav .back{background:none; border:0; color:var(--ink-2); font:600 15px/1 var(--sans); cursor:pointer; padding:12px 2px}
.calc-nav .grow{flex:1}

/* result */
.res{display:grid; grid-template-columns:1.1fr .9fr; gap:clamp(28px,4.4vw,64px); align-items:start}
@media (max-width:940px){ .res{grid-template-columns:1fr} }
.res-k{font:500 14px/1 var(--mono); color:var(--ink-3)}
.res-big{font:600 clamp(44px,6.4vw,84px)/.95 var(--mono); letter-spacing:-.06em; margin-top:14px; white-space:nowrap}
.res-big small{font:500 .24em/1 var(--sans); letter-spacing:0; color:var(--ink-3); margin-left:6px}
.delta{display:inline-flex; align-items:center; gap:8px; margin-top:16px; padding:10px 14px; border-radius:10px; background:var(--up-soft); color:var(--up); font:600 15px/1 var(--mono)}
.rows{margin-top:26px; border-top:1px solid var(--line)}
.row{display:flex; justify-content:space-between; align-items:baseline; gap:16px; padding:15px 0; border-bottom:1px solid var(--line)}
.row .num{font-size:19px; font-weight:600}
.row.dn .num{color:var(--down)}
.scale{margin-top:30px}
.track{position:relative; height:8px; border-radius:8px; background:linear-gradient(90deg, var(--down-soft), var(--bg-3) 50%, var(--up-soft)); margin-top:38px}
.pin{position:absolute; top:50%; transform:translate(-50%,-50%); width:18px; height:18px; border-radius:50%; border:3px solid var(--bg); box-shadow:0 1px 5px rgba(0,0,0,.3); transition:left 1s cubic-bezier(.2,.8,.2,1)}
.pin.now{background:var(--down)}
.pin.pot{background:var(--up)}
.pin b{position:absolute; bottom:22px; left:50%; transform:translateX(-50%); font:600 11px/1 var(--mono); white-space:nowrap; color:var(--ink-2)}
.ticks{position:relative; height:34px; margin-top:10px}
.ticks span{position:absolute; transform:translateX(-50%); font:500 11px/1.35 var(--mono); color:var(--ink-3); text-align:center; white-space:nowrap}
.disc{margin-top:18px; font-size:13px; color:var(--ink-3); max-width:58ch}
.gate{border:1px solid var(--line); border-radius:22px; padding:clamp(20px,3vw,30px); background:var(--bg-2)}
.gate h3{font-size:26px; letter-spacing:-.035em}
.gate > div > p.muted{margin-top:8px; font-size:15px}
.form{display:grid; gap:14px; margin-top:22px}
.row2{display:grid; grid-template-columns:1fr 1fr; gap:12px}
@media (max-width:520px){ .row2{grid-template-columns:1fr} }
.f{display:grid; gap:6px}
.f label, .f .lbl{font:600 14px/1.3 var(--sans)}
.f .o{font-weight:400; color:var(--ink-3)}
.f input, .f textarea{font:500 16px/1.4 var(--sans); color:var(--ink); background:var(--bg); border:1.5px solid var(--line); border-radius:12px; padding:14px; width:100%; transition:border-color .15s}
