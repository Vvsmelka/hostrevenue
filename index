  .mcta{display:flex; position:fixed; left:12px; right:12px; bottom:calc(12px + env(safe-area-inset-bottom,0px)); z-index:50; box-shadow:0 12px 32px -8px rgba(0,0,0,.45); transition:transform .3s, opacity .3s}
  .mcta.hide{transform:translateY(140%); opacity:0; pointer-events:none}
}
