/* ================= CTA ================= */
.cta{background:var(--inv-bg); color:var(--inv-ink); border-radius:32px; padding:clamp(40px,6.4vw,88px); display:grid; grid-template-columns:1.4fr auto; gap:36px; align-items:end; position:relative; overflow:hidden}
