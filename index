.nexts{list-style:none; margin:4px 0 0; padding:0; display:grid; gap:0; border-top:1px solid var(--line)}
.nexts li{display:grid; grid-template-columns:70px 1fr; gap:12px; padding:14px 0; border-bottom:1px solid var(--line); font-size:15px}
.nexts li span{font:500 13px/1.5 var(--mono); color:var(--ink-3)}

/* ================= HOW ================= */
.tl{display:grid; grid-template-columns:repeat(4,1fr); gap:0; list-style:none; margin:0; padding:0; position:relative}
@media (max-width:980px){ .tl{grid-template-columns:repeat(2,1fr); row-gap:36px} }
@media (max-width:560px){ .tl{grid-template-columns:1fr} }
.tl li{position:relative; padding:34px 24px 0 0}
