/* ================= COMPARE ================= */
.tbl{overflow-x:auto; border-radius:20px; border:1px solid var(--line)}
table.cmp{width:100%; border-collapse:collapse; min-width:680px}
.cmp th, .cmp td{padding:18px 20px; text-align:left; border-bottom:1px solid var(--line); font-size:15px; vertical-align:top}
.cmp thead th{font-size:15px; font-weight:600; color:var(--ink-2); background:var(--bg-2)}
.cmp thead th.us{background:var(--ink); color:var(--bg)}
.cmp td.us{font-weight:600; background:var(--bg-2)}
.cmp th[scope=row]{font-weight:500; color:var(--ink-3); width:24%}
.cmp tr:last-child td, .cmp tr:last-child th{border-bottom:0}

/* ================= FAQ ================= */
.faq-grid{display:grid; grid-template-columns:.8fr 1.2fr; gap:clamp(28px,5vw,80px)}
