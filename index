.ok .tick{width:52px; height:52px; border-radius:50%; background:var(--up); display:grid; place-items:center}
.ok .tick::after{content:""; width:18px; height:10px; border-left:3px solid #fff; border-bottom:3px solid #fff; transform:rotate(-45deg) translate(2px,-2px)}
