.cta h2{font-size:clamp(36px,5.2vw,72px); letter-spacing:-.05em; font-weight:800; max-width:16ch}
.cta p{margin-top:18px; color:var(--inv-2); max-width:46ch}
.cta .btn{background:var(--inv-ink); color:var(--inv-bg)}
