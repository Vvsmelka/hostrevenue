.check{display:flex; gap:12px; align-items:flex-start; font-size:13px; color:var(--ink-2); line-height:1.5; cursor:pointer}
.check input{width:20px; height:20px; margin-top:1px; accent-color:var(--ink); flex:none}
.check.bad{color:var(--err)}
.hp{position:absolute; left:-9999px; width:1px; height:1px; overflow:hidden}
.msg{font-size:14px; padding:12px 14px; border-radius:10px; background:color-mix(in srgb, var(--err) 10%, transparent); color:var(--err)}
